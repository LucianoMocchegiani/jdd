# Greenfield (persistence-api :8000 + game-server :8001 vía proxy Vite)
# Dejar vacío = proxy Vite en dev (npm run dev)

# Monolito Python legacy:
# VITE_API_BASE=/api/v1
# VITE_WS_URL=ws://localhost:8000/ws

# Gateway prod:
# VITE_WS_URL=ws://localhost:8082/ws

# MsgPack player_state (M6):
# VITE_WS_WIRE_FORMAT=msgpack
# (game-server: WIRE_FORMAT=msgpack)
